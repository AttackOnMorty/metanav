<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.metanav</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/.claude/skills/metanav/run.sh</string>
  </array>
  <!-- on the hour, every hour; run.sh itself keeps to weekdays within config.hours -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__OUT__/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__OUT__/logs/launchd.log</string>
</dict>
</plist>
